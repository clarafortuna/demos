<!DOCTYPE html>
<html lang="en">
<head>
<meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>conEdison - CLCPA DAC Performance Dashboard</title>
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
<style>
@import url('https://fonts.googleapis.com/css2?family=Barlow:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400&family=Barlow+Condensed:wght@600;700;800&family=Inter:wght@400;500;600&display=swap');

:root {
  --ink:      #0f1923;
  --ink-2:    #2d3f4e;
  --ink-3:    #4a6070;
  --mist:     #8fa8b6;
  --fog:      #c8d8e0;
  --cloud:    #e8f0f4;
  --paper:    #f4f8fa;
  --white:    #ffffff;
  --teal:     #0072BC;
  --teal-lt:  #4da6e0;
  --teal-dim: #005a9e;
  --green:    #1a7a4a;
  --green-lt: #d1f0e0;
  --amber:    #b05c00;
  --amber-lt: #fdebd0;
  --red:      #b01a2e;
  --red-lt:   #fde0e4;
  --sidebar-w: 56px;
  --sidebar-exp: 240px;
  --header-h: 54px;
  --r: 12px;
  --r-sm: 8px;
  --shadow: 0 2px 12px rgba(15,25,35,0.08);
  --shadow-md: 0 4px 24px rgba(15,25,35,0.12);
}

*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
html, body { height: 100%; font-family: 'Barlow', 'Helvetica Neue', Helvetica, Arial, sans-serif; background: var(--paper); color: var(--ink); font-size: 14px; line-height: 1.5; }

/* -- LAYOUT -------------------------------------------------- */
#app { display: flex; height: 100vh; overflow: hidden; }

/* -- SIDEBAR ------------------------------------------------- */
#sidebar {
  width: var(--sidebar-w);
  min-width: var(--sidebar-w);
  background: var(--ink);
  display: flex;
  flex-direction: column;
  transition: width 0.22s cubic-bezier(.4,0,.2,1);
  overflow: hidden;
  z-index: 100;
  flex-shrink: 0;
}
#sidebar.expanded { width: var(--sidebar-exp); }

.sb-logo {
  height: var(--header-h);
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 0 14px;
  border-bottom: 1px solid rgba(255,255,255,0.07);
  white-space: nowrap;
  overflow: hidden;
}
.sb-logo-mark {
  width: 28px; height: 28px; min-width: 28px;
  background: var(--teal);
  border-radius: 7px;
  display: flex; align-items: center; justify-content: center;
  font-family: 'Barlow Condensed', 'Barlow', sans-serif;
  font-style: italic;
  color: white;
  font-size: 15px;
  font-weight: 400;
  letter-spacing: -0.3px;
}
.sb-logo-text {
  font-size: 11px;
  font-weight: 600;
  color: var(--fog);
  letter-spacing: 0.05em;
  text-transform: uppercase;
  line-height: 1.3;
  opacity: 0;
  transition: opacity 0.15s;
}
#sidebar.expanded .sb-logo-text { opacity: 1; transition-delay: 0.05s; }

.sb-nav { flex: 1; padding: 8px 0; overflow-y: auto; overflow-x: hidden; }
.sb-nav::-webkit-scrollbar { width: 3px; }
.sb-nav::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.1); border-radius: 2px; }

.sb-item {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 9px 14px;
  cursor: pointer;
  border-radius: 0;
  transition: background 0.12s;
  white-space: nowrap;
  overflow: hidden;
  position: relative;
  border-left: 3px solid transparent;
}
.sb-item:hover { background: rgba(255,255,255,0.06); }
.sb-item.active { background: rgba(47,111,137,0.25); border-left-color: var(--teal-lt); }

.sb-icon {
  width: 28px; height: 28px; min-width: 28px;
  display: flex; align-items: center; justify-content: center;
  color: var(--mist);
  font-size: 16px;
  transition: color 0.12s;
}
.sb-item.active .sb-icon,
.sb-item:hover .sb-icon { color: var(--teal-lt); }

.sb-label {
  font-size: 12.5px;
  font-weight: 500;
  color: var(--fog);
  opacity: 0;
  transition: opacity 0.12s;
  line-height: 1.2;
}
#sidebar.expanded .sb-label { opacity: 1; transition-delay: 0.06s; }
.sb-item.active .sb-label { color: var(--white); }

.sb-section-label {
  font-size: 9.5px;
  font-weight: 600;
  color: rgba(255,255,255,0.25);
  letter-spacing: 0.1em;
  text-transform: uppercase;
  padding: 16px 17px 4px;
  white-space: nowrap;
  overflow: hidden;
  opacity: 0;
  height: 0;
  transition: opacity 0.12s, height 0.12s;
}
#sidebar.expanded .sb-section-label { opacity: 1; height: auto; }

.sb-toggle {
  padding: 12px 14px;
  border-top: 1px solid rgba(255,255,255,0.07);
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--mist);
  transition: color 0.12s;
}
.sb-toggle:hover { color: var(--white); }

/* -- MAIN ---------------------------------------------------- */
#main {
  flex: 1;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  min-width: 0;
}

/* -- TOPBAR -------------------------------------------------- */
#topbar {
  height: var(--header-h);
  background: var(--white);
  border-bottom: 1px solid var(--cloud);
  display: flex;
  align-items: center;
  padding: 0 24px;
  gap: 16px;
  flex-shrink: 0;
  z-index: 10;
}
.tb-title { font-size: 14px; font-weight: 600; color: var(--ink); flex: 1; }
.tb-sub { font-size: 11px; color: var(--mist); font-family: 'Inter', 'Helvetica Neue', monospace; }
.tb-badge {
  background: var(--teal);
  color: white;
  font-size: 10px;
  font-weight: 600;
  padding: 3px 8px;
  border-radius: 100px;
  letter-spacing: 0.04em;
}
.tb-period {
  font-size: 11px;
  color: var(--ink-3);
  background: var(--cloud);
  padding: 4px 10px;
  border-radius: 6px;
  font-family: 'Inter', 'Helvetica Neue', monospace;
}

/* -- CONTENT ------------------------------------------------- */
#content {
  flex: 1;
  overflow-y: auto;
  padding: 24px;
  scroll-behavior: smooth;
}
#content::-webkit-scrollbar { width: 5px; }
#content::-webkit-scrollbar-thumb { background: var(--fog); border-radius: 3px; }

.page { display: none; }
.page.active { display: block; animation: fadeIn 0.18s ease; }
@keyframes fadeIn { from { opacity:0; transform:translateY(4px); } to { opacity:1; transform:none; } }

/* -- SECTION HEADER ------------------------------------------ */
.pg-header {
  margin-bottom: 20px;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 12px;
}
.pg-title {
  font-family: 'Barlow Condensed', 'Barlow', sans-serif;
  font-size: 22px;
  font-weight: 400;
  color: var(--ink);
  line-height: 1.2;
}
.pg-subtitle { font-size: 12px; color: var(--mist); margin-top: 2px; }

/* -- GRID UTILITIES ------------------------------------------ */
.grid-3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
.grid-2 { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px; }
.grid-4 { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; }
.grid-5 { display: grid; grid-template-columns: repeat(5, 1fr); gap: 14px; }
.col-span-2 { grid-column: span 2; }
.col-span-3 { grid-column: span 3; }

/* -- CARDS --------------------------------------------------- */
.card {
  background: var(--white);
  border: 1px solid var(--cloud);
  border-radius: var(--r);
  padding: 20px;
  box-shadow: var(--shadow);
}
.card-sm { padding: 14px 16px; }
.card-hd {
  font-size: 10.5px;
  font-weight: 600;
  color: var(--mist);
  text-transform: uppercase;
  letter-spacing: 0.07em;
  margin-bottom: 6px;
}
.card-val {
  font-size: 26px;
  font-weight: 600;
  color: var(--ink);
  line-height: 1.1;
  font-variant-numeric: tabular-nums;
}
.card-val-sm { font-size: 20px; }
.card-meta { font-size: 11.5px; color: var(--ink-3); margin-top: 4px; }

/* -- KPI CARD (with target bar) ------------------------------ */
.kpi-card {
  background: var(--white);
  border: 1px solid var(--cloud);
  border-radius: var(--r);
  padding: 16px;
  box-shadow: var(--shadow);
  display: flex;
  flex-direction: column;
  gap: 10px;
}
.kpi-top { display: flex; justify-content: space-between; align-items: flex-start; }
.kpi-label { font-size: 11px; font-weight: 600; color: var(--mist); text-transform: uppercase; letter-spacing: 0.06em; }
.kpi-status { font-size: 9.5px; font-weight: 700; padding: 2px 7px; border-radius: 100px; }
.status-ok  { background: var(--green-lt); color: var(--green); }
.status-warn { background: var(--amber-lt); color: var(--amber); }
.status-bad { background: var(--red-lt); color: var(--red); }
.kpi-val { font-size: 28px; font-weight: 700; color: var(--ink); line-height: 1; font-variant-numeric: tabular-nums; }
.kpi-bar-wrap { position: relative; height: 6px; background: var(--cloud); border-radius: 3px; overflow: hidden; }
.kpi-bar-fill { height: 100%; border-radius: 3px; transition: width 0.6s cubic-bezier(.4,0,.2,1); }
.kpi-bar-markers { display: flex; justify-content: space-between; margin-top: 4px; }
.kpi-bar-marker { font-size: 9.5px; color: var(--mist); font-family: 'Inter', 'Helvetica Neue', monospace; }
.kpi-yoy { font-size: 11px; font-weight: 500; }
.up   { color: var(--green); }
.down { color: var(--red); }
.flat { color: var(--mist); }

/* -- CAPITAL CARD -------------------------------------------- */
.cap-card {
  border-radius: var(--r);
  padding: 20px 22px;
  display: flex;
  flex-direction: column;
  gap: 14px;
}
.cap-card-0 { background: var(--teal); }
.cap-card-1 { background: rgba(47,111,137,0.12); border: 1px solid rgba(47,111,137,0.2); }
.cap-card-2 { background: var(--cloud); border: 1px solid var(--fog); }
.cap-label { font-size: 10px; font-weight: 700; letter-spacing: 0.09em; text-transform: uppercase; }
.cap-card-0 .cap-label { color: rgba(255,255,255,0.7); }
.cap-card-1 .cap-label, .cap-card-2 .cap-label { color: var(--ink-3); }
.cap-value { font-size: 30px; font-weight: 700; line-height: 1; }
.cap-card-0 .cap-value { color: white; }
.cap-card-1 .cap-value, .cap-card-2 .cap-value { color: var(--ink); }
.cap-secondary { font-size: 11px; }
.cap-card-0 .cap-secondary { color: rgba(255,255,255,0.65); }
.cap-card-1 .cap-secondary, .cap-card-2 .cap-secondary { color: var(--ink-3); }
.cap-delta { font-size: 11.5px; font-weight: 700; }
.cap-card-0 .cap-delta { color: #7dffc3; }
.cap-card-1 .cap-delta { color: var(--green); }
.cap-card-2 .cap-delta { color: var(--green); }
.cap-breakdown { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; }
.cap-mini {
  border-radius: 8px;
  padding: 8px 10px;
}
.cap-card-0 .cap-mini { background: rgba(0,0,0,0.18); }
.cap-card-1 .cap-mini, .cap-card-2 .cap-mini { background: rgba(0,0,0,0.05); }
.cap-mini-label { font-size: 9.5px; }
.cap-card-0 .cap-mini-label { color: rgba(255,255,255,0.6); }
.cap-card-1 .cap-mini-label, .cap-card-2 .cap-mini-label { color: var(--ink-3); }
.cap-mini-val { font-size: 12.5px; font-weight: 700; margin-top: 2px; }
.cap-card-0 .cap-mini-val { color: white; }
.cap-card-1 .cap-mini-val, .cap-card-2 .cap-mini-val { color: var(--ink); }

/* -- TABLE --------------------------------------------------- */
.tbl-wrap { overflow-x: auto; }
table { width: 100%; border-collapse: collapse; }
thead th {
  font-size: 10.5px;
  font-weight: 700;
  color: var(--mist);
  text-transform: uppercase;
  letter-spacing: 0.07em;
  padding: 10px 12px;
  background: var(--paper);
  border-bottom: 1px solid var(--cloud);
  text-align: left;
  white-space: nowrap;
}
tbody tr { border-bottom: 1px solid var(--cloud); transition: background 0.1s; }
tbody tr:hover { background: var(--paper); }
tbody td { padding: 10px 12px; font-size: 13px; color: var(--ink-2); }
.td-right { text-align: right; font-family: 'Inter', 'Helvetica Neue', monospace; font-size: 12.5px; }
.td-mono { font-family: 'Inter', 'Helvetica Neue', monospace; font-size: 12px; }
.td-bold { font-weight: 600; color: var(--ink); }

/* -- CHART WRAPPER ------------------------------------------- */
.chart-wrap { position: relative; }
.chart-title { font-size: 12px; font-weight: 600; color: var(--ink-2); margin-bottom: 12px; }

/* -- SECTION DIVIDER ----------------------------------------- */
.section-divider {
  margin: 24px 0 16px;
  display: flex;
  align-items: center;
  gap: 10px;
}
.section-divider span {
  font-size: 11px;
  font-weight: 700;
  color: var(--ink-3);
  text-transform: uppercase;
  letter-spacing: 0.08em;
  white-space: nowrap;
}
.section-divider::before, .section-divider::after {
  content: '';
  flex: 1;
  height: 1px;
  background: var(--cloud);
}
.section-divider::before { display: none; }

/* -- HEAT CELL ----------------------------------------------- */
.heat-cell {
  padding: 5px 8px;
  border-radius: 6px;
  text-align: center;
  font-size: 11.5px;
  font-weight: 700;
  font-family: 'Inter', 'Helvetica Neue', monospace;
  display: inline-block;
  min-width: 52px;
}

/* -- PROGRESS BAR -------------------------------------------- */
.prog-row { display: flex; align-items: center; gap: 10px; margin-bottom: 10px; }
.prog-label { font-size: 12px; color: var(--ink-2); min-width: 120px; }
.prog-bar-bg { flex: 1; height: 8px; background: var(--cloud); border-radius: 4px; overflow: hidden; }
.prog-bar-fill { height: 100%; background: var(--teal); border-radius: 4px; }
.prog-val { font-size: 12px; font-family: 'Inter', 'Helvetica Neue', monospace; color: var(--ink-2); min-width: 40px; text-align: right; }

/* -- EXECUTIVE OVERVIEW CARD --------------------------------- */
.ov-card {
  background: white;
  border: 1px solid var(--cloud);
  border-radius: var(--r);
  padding: 14px 16px;
  display: flex;
  flex-direction: column;
  gap: 6px;
  box-shadow: var(--shadow);
  cursor: pointer;
  transition: border-color 0.12s, box-shadow 0.12s;
}
.ov-card:hover { border-color: var(--teal); box-shadow: 0 4px 16px rgba(47,111,137,0.12); }
.ov-section { font-size: 10px; font-weight: 700; color: var(--mist); text-transform: uppercase; letter-spacing: 0.07em; }
.ov-kpi { font-size: 11.5px; color: var(--ink-3); }
.ov-val { font-size: 22px; font-weight: 700; color: var(--ink); font-variant-numeric: tabular-nums; }
.ov-yoy { font-size: 11px; font-weight: 500; }

/* -- BOROUGH MAP (placeholder) ------------------------------- */
.borough-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; }
.borough-card {
  background: white;
  border: 1px solid var(--cloud);
  border-radius: var(--r-sm);
  padding: 14px;
  text-align: center;
}
.borough-name { font-size: 12px; font-weight: 600; color: var(--ink-2); }
.borough-share { font-size: 22px; font-weight: 700; color: var(--teal); margin: 4px 0; }
.borough-meta { font-size: 10.5px; color: var(--mist); }

/* -- TOGGLE --------------------------------------------------- */
.toggle-row { display: flex; gap: 4px; background: var(--paper); border: 1px solid var(--cloud); border-radius: 8px; padding: 3px; }
.toggle-btn {
  padding: 5px 14px;
  border-radius: 5px;
  font-size: 11.5px;
  font-weight: 600;
  cursor: pointer;
  border: none;
  background: transparent;
  color: var(--ink-3);
  transition: all 0.12s;
}
.toggle-btn.active { background: white; color: var(--ink); box-shadow: 0 1px 4px rgba(0,0,0,0.08); }

/* -- EXPORT BTN ----------------------------------------------- */
.export-btn {
  display: inline-flex; align-items: center; gap: 5px;
  padding: 6px 12px;
  background: var(--paper);
  border: 1px solid var(--cloud);
  border-radius: 7px;
  font-size: 11px;
  font-weight: 600;
  color: var(--ink-2);
  cursor: pointer;
  transition: all 0.12s;
}
.export-btn:hover { background: var(--cloud); border-color: var(--fog); }

/* -- CLEAN ENERGY CRUD --------------------------------------- */
.crud-card { margin-bottom: 20px; }
.crud-actions { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }
.crud-status { font-size: 11.5px; color: var(--mist); margin-top: 8px; min-height: 18px; }
.crud-status.error { color: var(--red); }
.crud-status.ok { color: var(--green); }
.crud-form { display: none; margin-top: 16px; border-top: 1px solid var(--cloud); padding-top: 16px; }
.crud-form.active { display: block; }
.crud-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }
.form-field { display: flex; flex-direction: column; gap: 5px; }
.form-field label { font-size: 10.5px; font-weight: 700; color: var(--mist); text-transform: uppercase; letter-spacing: 0.07em; }
.form-field input, .form-field select {
  border: 1px solid var(--cloud);
  border-radius: 7px;
  padding: 8px 10px;
  font-family: 'Inter', 'Helvetica Neue', monospace;
  font-size: 12px;
  color: var(--ink);
  background: white;
}
.form-field input:focus, .form-field select:focus { outline: 2px solid rgba(0,114,188,0.18); border-color: var(--teal); }
.form-hint { font-size: 10.5px; color: var(--mist); margin-top: 8px; }
.row-actions { display: flex; justify-content: flex-end; gap: 6px; }
.link-btn { border: none; background: transparent; color: var(--teal); cursor: pointer; font-weight: 700; font-size: 11.5px; }
.link-btn:disabled { color: var(--mist); cursor: not-allowed; }

/* -- RESPONSIVE ----------------------------------------------- */
@media (max-width: 900px) {
  .grid-3 { grid-template-columns: 1fr 1fr; }
  .grid-5 { grid-template-columns: 1fr 1fr; }
  .grid-4 { grid-template-columns: 1fr 1fr; }
  .crud-grid { grid-template-columns: 1fr 1fr; }
}
@media (max-width: 620px) {
  .grid-3, .grid-2, .grid-4, .grid-5 { grid-template-columns: 1fr; }
  .crud-grid { grid-template-columns: 1fr; }
  .col-span-2, .col-span-3 { grid-column: span 1; }
}
</style>
</head>
