}
function validateCesForm() {
  const errors = [];
  [['ces-period','Period'], ['ces-program','Program'], ['ces-dacstatus','DAC Status']].forEach(([id, label]) => { if (!getInput(id)) errors.push(`${label} is required.`); });
  [['ces-customersegmentcode','Customer Segment Code',100], ['ces-measurecategorycode','Measure Category Code',100]].forEach(([id, label, max]) => { if (getInput(id).length > max) errors.push(`${label} cannot exceed ${max} characters.`); });
  [['ces-incentivedollars','Incentive Dollars'], ['ces-energysavingsmmbtu','Energy Savings MMBtu']].forEach(([id, label]) => {
    const value = getInput(id);
    if (value === '') return;
    const n = Number(value);
    if (!Number.isFinite(n) || n < -100000000000 || n > 100000000000) errors.push(`${label} must be between -100,000,000,000 and 100,000,000,000.`);
    if (!/^-?\d+(\.\d{1,2})?$/.test(value)) errors.push(`${label} allows up to 2 decimal places.`);
  });
  [['ces-participants','Participants'], ['ces-installations','Installations']].forEach(([id, label]) => {
    const value = getInput(id);
    if (value === '') return;
    const n = Number(value);
    if (!Number.isFinite(n) || !isWholeNumber(value) || n < -2147483648 || n > 2147483647) errors.push(`${label} must be a whole number between -2,147,483,648 and 2,147,483,647.`);
  });
  const source = generateCesSourceTable();
  if (source.length > 850) errors.push('Generated source table cannot exceed 850 characters.');
  return errors;
}
function buildCesPayload() {
  const payload = {
    cf_sourcetable: generateCesSourceTable(),
    'cf_period@odata.bind': `/${ENTITY.periods}(${getInput('ces-period')})`,
    'cf_program@odata.bind': `/${ENTITY.programs}(${getInput('ces-program')})`,
    'cf_dacstatus@odata.bind': `/${ENTITY.dac}(${getInput('ces-dacstatus')})`
  };
  [['cf_customersegmentcode','ces-customersegmentcode'], ['cf_measurecategorycode','ces-measurecategorycode']].forEach(([field, id]) => { payload[field] = getInput(id) || null; });
  [['cf_incentivedollars','ces-incentivedollars'], ['cf_energysavingsmmbtu','ces-energysavingsmmbtu'], ['cf_participants','ces-participants'], ['cf_installations','ces-installations']].forEach(([field, id]) => { payload[field] = numOrNull(id); });
  return payload;
}
function showCesForm(record) {
  populateCesLookups();
  setInput('ces-record-id', record ? record.cf_factcleanenergyspendingid : '');
  setInput('ces-period', record ? getLookupId(record, 'period') : '');
  setInput('ces-program', record ? getLookupId(record, 'program') : '');
  setInput('ces-dacstatus', record ? getLookupId(record, 'dacstatus') : '');
  setInput('ces-customersegmentcode', record ? record.cf_customersegmentcode : '');
  setInput('ces-measurecategorycode', record ? record.cf_measurecategorycode : '');
  setInput('ces-incentivedollars', record ? record.cf_incentivedollars : '');
  setInput('ces-energysavingsmmbtu', record ? record.cf_energysavingsmmbtu : '');
  setInput('ces-participants', record ? record.cf_participants : '');
  setInput('ces-installations', record ? record.cf_installations : '');
  setText('ces-form-title', record ? 'Edit Clean Energy Record' : 'Submit Clean Energy Record');
  const form = document.getElementById('ces-form');
  if (form) form.classList.add('active');
  updateCesSourcePreview();
}
function hideCesForm() {
  const form = document.getElementById('ces-form');
  if (form) form.classList.remove('active');
}
function renderCesCrudGrid(rows) {
  const tbody = document.getElementById('ces-crud-tbody');
  if (!tbody) return;
  if (!rows.length) {
    tbody.innerHTML = '<tr><td colspan="7">No Clean Energy Spending records found.</td></tr>';
    return;
  }
  tbody.innerHTML = rows.map(r => {
    const period = periodFor(r), program = programFor(r), dac = dacStatusFor(r);
    return `<tr>
      <td>${esc(optionLabel(period && (period.cf_periodlabel || period.cf_calendaryear)))}</td>
      <td class="td-bold">${esc(optionLabel(program && (program.cf_programname || program.cf_programcode)))}</td>
      <td>${esc(optionLabel(dac && (dac.cf_dacstatuslabel || dac.cf_dacstatuscode)))}</td>
      <td>${esc(optionLabel(r.cf_customersegmentcode, ''))}</td>
      <td class="td-right td-mono">${'$' + fmt2(r.cf_incentivedollars || 0)}</td>
      <td class="td-right td-mono">${fmt0(r.cf_participants || 0)}</td>
      <td class="td-right"><div class="row-actions"><button class="link-btn" type="button" onclick="editCesRecord('${r.cf_factcleanenergyspendingid}')">Edit</button><button class="link-btn" type="button" disabled title="Delete is disabled for Phase 1">Delete disabled</button></div></td>
    </tr>`;
  }).join('');
}
async function loadCesCrudGrid() {
  try {
    cesStatus('Loading Clean Energy records...');
    if (!latestDashboardData) latestDashboardData = await getDashboardData();
    cacheLookups(latestDashboardData);
    populateCesLookups();
    renderCesCrudGrid(latestDashboardData.ces || []);
    cesStatus(`Loaded ${(latestDashboardData.ces || []).length} Clean Energy records.`, 'ok');
  } catch (err) {
    console.error(err);
    cesStatus('Clean Energy records failed to load - ' + err.message, 'error');
  }
}
function editCesRecord(id) {
  const record = ((latestDashboardData && latestDashboardData.ces) || []).find(r => normGuid(r.cf_factcleanenergyspendingid) === normGuid(id));
  if (!record) { cesStatus('Unable to find the selected Clean Energy record.', 'error'); return; }
  showCesForm(record);
}
async function saveCesRecord(event) {
  event.preventDefault();
  const errors = validateCesForm();
  if (errors.length) { cesStatus(errors.join(' '), 'error'); return; }
  const id = getInput('ces-record-id');
  try {
    cesStatus(id ? 'Updating Clean Energy record...' : 'Creating Clean Energy record...');
    if (id) await dvPatch(ENTITY.ces, id, buildCesPayload());
    else await dvPost(ENTITY.ces, buildCesPayload());
    hideCesForm();
    latestDashboardData = await getDashboardData();
    renderDashboard(latestDashboardData);
    renderCesCrudGrid(latestDashboardData.ces || []);
    cesStatus(id ? 'Clean Energy record updated.' : 'Clean Energy record created.', 'ok');
    setStatus(`Live data v${DASHBOARD_VERSION}`);
  } catch (err) {
    console.error(err);
    cesStatus('Save failed - ' + err.message, 'error');
  }
}
['ces-period','ces-program','ces-dacstatus'].forEach(id => document.addEventListener('change', event => { if (event.target && event.target.id === id) updateCesSourcePreview(); }));

function clearDashboardValues() {
  document.querySelectorAll('.kpi-val,.ov-val,.cap-value,.cap-mini-val,.borough-share').forEach(el => { el.textContent = '...'; });
  const execBody = document.getElementById('exec-tbody');
  if (execBody) execBody.innerHTML = '<tr><td colspan="4">Loading...</td></tr>';
  const cesBody = document.querySelector('#page-ces .card:not(.crud-card) table tbody');
  if (cesBody) cesBody.innerHTML = '<tr><td colspan="6">Loading...</td></tr>';
  Object.keys(charts).forEach(id => { charts[id].destroy(); delete charts[id]; });
}

async function loadDashboard() {
  clearDashboardValues();
  try {
    const data = await getDashboardData();
    latestDashboardData = data;
    if (!data.ces.length) {
      setStatus('No dashboard rows were found in the CLCPA tables.', true);
      renderCesCrudGrid([]);
      return;
    }
    renderDashboard(data);
    renderCesCrudGrid(data.ces || []);
    populateCesLookups();
    cesStatus(`Loaded ${(data.ces || []).length} Clean Energy records.`, 'ok');
    setStatus(`Live data v${DASHBOARD_VERSION}`);
  } catch (err) {
    console.error(err);
    setStatus('Could not load dashboard - ' + err.message, true);
    cesStatus('Clean Energy records failed to load - ' + err.message, 'error');
  }
}
window.addEventListener('load', loadDashboard);
</script>
