    <div class="sb-item" data-page="sec" onclick="nav(this)">
      <div class="sb-icon"></div>
      <div class="sb-label">Strategic Capital</div>
    </div>

    <div class="sb-section-label">Sections F-J</div>
    <div class="sb-item" data-page="outages" onclick="nav(this)">
      <div class="sb-icon">*</div>
      <div class="sb-label">Customer Outages</div>
    </div>
    <div class="sb-item" data-page="main" onclick="nav(this)">
      <div class="sb-icon"></div>
      <div class="sb-label">Main Replacement</div>
