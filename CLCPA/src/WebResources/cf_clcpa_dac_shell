<script>
(function () {
  'use strict';

  var API = '/api/data/v9.2/';
  /** Reporting years exposed in dashboard & ingestion year selectors (subset of cf_dimperiod data in env). */
  var DASHBOARD_MIN_REPORTING_YEAR = 2023;
  var DASHBOARD_MAX_REPORTING_YEAR = 2024;
  var periods = [];
  var dacStatuses = [];
  var activeSection = 'a';
  var ingestionLetter = 'a';
  var dashAssetsPromise = null;
  /** New update 55-table editors (localStorage) — cf_clcpa_dash_data_ingestion_page */
  var USE_PROTO_DATA_INGESTION = true;
  window.__DAC_SHELL_API = {
    getYear: function () {
      var el = document.getElementById('filter-year');
      return el && el.value ? el.value : '2024';
    },
    get stateA() { return stateA; },
    get stateB() { return stateB; },
    get stateC() { return stateC; },
    get stateD() { return stateD; },
    get stateE() { return stateE; },
    get stateF() { return stateF; },
    get stateG() { return stateG; },
    get stateH() { return stateH; },
    get stateI() { return stateI; },
    get stateJ() { return stateJ; }
  };

  function shellDiagInfo(msg, detail) {
    if (typeof console !== 'undefined' && console.info) {
      console.info('[CLCPA shell] ' + msg, detail !== undefined ? detail : '');
    }
  }
  function shellDiagWarn(msg, detail) {
    if (typeof console !== 'undefined' && console.warn) {
      console.warn('[CLCPA shell] ' + msg, detail !== undefined ? detail : '');
    }
  }
  function verifyShellNavigationDom() {
    var missing = [];
    if (!document.getElementById('nav-exec')) missing.push('nav-exec');
    if (!document.getElementById('view-exec')) missing.push('view-exec');
    if (!document.getElementById('view-ingestion')) missing.push('view-ingestion');
    if (!document.getElementById('nav-ingestion')) missing.push('nav-ingestion');
    if (!document.getElementById('ingest-editor-area')) missing.push('ingest-editor-area');
    var letters = ['a', 'b', 'c', 'd', 'e', 'f', 'g', 'h', 'i', 'j'];
    for (var i = 0; i < letters.length; i++) {
      var L = letters[i];
      if (!document.getElementById('nav-' + L)) missing.push('nav-' + L);
      if (!document.getElementById('view-' + L)) missing.push('view-' + L);
    }
    if (missing.length) {
      shellDiagWarn('missing view/nav ids', missing.join(', '));
    } else {
      shellDiagInfo('navigation DOM OK');
    }
  }

  function loadDashScripts() {
    if (dashAssetsPromise) return dashAssetsPromise;
    dashAssetsPromise = new Promise(function (resolve, reject) {
      try {
        var base = getClientUrl();
        var s = document.createElement('script');
        s.src = base + '/WebResources/cf_clcpa_dash_hybrid';
        s.onload = function () {
          if (!window.CLCPADash || !window.CLCPADash.loadScripts) {
            reject(new Error('Hybrid runtime missing'));
            return;
          }
          window.CLCPADash.loadScripts(base, function (err) {
            if (err) reject(err);
            else resolve();
          });
        };
        s.onerror = function () { reject(new Error('Could not load cf_clcpa_dash_hybrid')); };
        document.head.appendChild(s);
      } catch (e) {
        reject(e);
      }
    });
    return dashAssetsPromise;
  }

  function refreshExecDashboard() {
    if (!window.CLCPADash || !window.__LEGACY_DASH) return;
    var host = document.getElementById('dash-mount-exec');
    if (!host) return;
    host.innerHTML =
      '<div class="kpi-group analytical"><div class="kpi-group-header"><h2>Analytical KPIs</h2><span class="group-tag">Derived Metrics</span><span class="group-desc">Composite measures we built · Formula shown on each card</span></div><div class="kpi-grid" id="dash-kpi-analytical"></div></div>' +
      '<div class="kpi-group"><div class="kpi-group-header"><h2>Reported KPIs</h2><span class="group-tag">From Source Reports</span><span class="group-desc">Twelve metrics copied directly from the 2023 and 2024 PDFs · No derivation</span></div><div class="kpi-grid" id="dash-kpi-reported"></div></div>';
    window.CLCPADash.mountExecutive(host, document.getElementById('filter-year'));
    syncExecHeroMeta();
  }

  function refreshSectionDashboard(letter) {
    if (!window.CLCPADash || !window.CLCPADashMountSection || !window.__LEGACY_DASH) return;
    var host = document.getElementById('dash-mount-' + letter);
    if (!host) return;
    host.innerHTML = '';
    var inner = document.createElement('div');
    inner.className = 'dash-inner';
    var sec = window.__LEGACY_DASH['section' + letter.toUpperCase()];
    var L = letter.toUpperCase();
    var overviewHtml = sec
      ? '<div class="section-overview">' +
        '<div class="section-overview-icon">' + L + '</div>' +
        '<div class="section-overview-text"><h2>' + escapeHtml(sec.section_name || '') + '</h2><p>' + escapeHtml(sec.blurb || '') + '</p></div>' +
        '<dl class="section-overview-stats page-header-meta" data-dash-stats></dl></div>' +
        '<div class="section-divider"><span class="icon"></span> Visual Analytics <span class="icon" style="background:var(--dusk)"></span></div>' +
        '<div data-dash-charts></div>' +
        '<div class="section-divider"><span class="icon"></span> Source Tables <span class="icon" style="background:var(--dusk)"></span></div>' +
        '<div data-dash-tables></div>'
      : '<div data-dash-charts></div><div data-dash-tables></div>';
    inner.innerHTML = overviewHtml;
    host.appendChild(inner);
    if (!sec) return;
    var payload = window.CLCPADash.mergePayload(letter.toUpperCase(), sec, window.__DAC_SHELL_API);
    window.CLCPADashMountSection(inner, payload, document.getElementById('filter-year'));
  }

  function refreshDashboardForActive() {
    if (activeSection === 'ingestion') return;
    loadDashScripts().then(function () {
      if (activeSection === 'exec') {
        refreshExecDashboard();
        return;
      }
      refreshSectionDashboard(activeSection);
    }).catch(function (err) {
      shellDiagWarn('dashboard script load failed', err && err.message ? err.message : err);
    });
  }

  function refreshDashboardForActiveSectionAfterSave(savedLetter) {
    if (USE_PROTO_DATA_INGESTION) return;
    loadDashScripts().then(function () {
      if (activeSection === 'ingestion') {
        if (savedLetter !== ingestionLetter) return;
        refreshSectionDashboard(savedLetter);
        return;
      }
      if (activeSection === savedLetter) {
        refreshSectionDashboard(savedLetter);
      }
    }).catch(function (err) {
      shellDiagWarn('dashboard refresh after save failed', err && err.message ? err.message : err);
    });
  }

  var stateA = {
    programs: [],
    facts: [],
    editId: null
  };
  var ENTITY_SET_A = 'cf_factcleanenergyspendings';
  var SOURCE_TABLE_A = 'UI-SectionA';

  var stateB = {
    facts: [],
    editId: null
  };
  var ENTITY_SET_B = 'cf_factevmakereadys';
  var SOURCE_TABLE_B = 'UI-SectionB';

  var stateC = {
    programs: [],
    facts: [],
    editId: null
  };
  var ENTITY_SET_C = 'cf_factdemandresponses';
  var SOURCE_TABLE_C = 'UI-SectionC';

  var stateD = {
    facts: [],
    editId: null
  };
  var ENTITY_SET_D = 'cf_factders';
  var SOURCE_TABLE_D = 'UI-SectionD';

  var stateE = {
    facts: [],
    editId: null
  };
  var ENTITY_SET_E = 'cf_factstrategiccapinvestments';
  var SOURCE_TABLE_E = 'UI-SectionE';

  var stateF = {
    facts: [],
    editId: null,
    duplicateUsesGeo: false
  };
  var ENTITY_SET_F = 'cf_factcustomeroutagess';
  var SOURCE_TABLE_F = 'UI-SectionF';
  var geographies = [];

  var stateG = {
    facts: [],
    editId: null,
    duplicateUsesGeo: false
  };
  var ENTITY_SET_G = 'cf_factmainreplacements';
  var SOURCE_TABLE_G = 'UI-SectionG';
  var MILES_TO_FEET = 5280;

  var stateH = {
    facts: [],
    editId: null,
    duplicateUsesGeo: false
  };
  var ENTITY_SET_H = 'cf_factleakrepairss';
  var SOURCE_TABLE_H = 'UI-SectionH';

  var stateI = {
    programs: [],
    facts: []
  };
  var ENTITY_SET_I = 'cf_factcleanenergyjobss';
  var SOURCE_TABLE_I = 'UI-SectionI';
