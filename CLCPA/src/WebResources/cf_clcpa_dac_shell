<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Con Edison · CLCPA — DAC Report (Sections A–J)</title>
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
<link rel="stylesheet" type="text/css" href="/WebResources/cf_clcpa_dash_shared_css" />
<style>
/* Shell-only — DAC_Report HTML package design system is in cf_clcpa_dash_shared_css */
.shell-page-header h1 { font-size: 22px; margin: 0 0 6px; }
.shell-page-sub { color: var(--text-3); margin: 0 0 18px; max-width: 720px; }
/* Unified editor surface — closer to New update single chart-card editors */
.ingest-submission-zone {
  background: var(--white);
  border: 1px solid var(--line);
  border-radius: 8px;
  padding: 16px 18px 18px;
  margin-bottom: 16px;
}
.ingest-submission-zone .ingest-section-hero.chart-card {
  background: transparent;
  border: none;
  padding: 0;
  margin: 0 0 14px;
  box-shadow: none;
}
.ingest-submission-zone .ingest-section-hero .chart-card-head {
  margin-bottom: 0;
}
.ingest-submission-zone .summary-grid {
  margin-bottom: 16px;
}
.ingest-submission-zone .summary-card {
  background: var(--bright-snow);
}
.ingest-submission-zone .ingest-form-row {
  gap: 12px;
  align-items: stretch;
  margin-bottom: 0;
}
.ingest-submission-zone .ingest-form-row > .chart-card {
  background: var(--bright-snow);
  border: 1px solid var(--line);
  box-shadow: none;
}
.ingest-submission-zone .ingest-panel-form .chart-card-head,
.ingest-submission-zone .ingest-panel-grid .chart-card-head {
  margin-bottom: 12px;
}
.shell-count-badge { font-size: 10px; padding: 2px 6px; border-radius: 4px; background: var(--dusk-tint); color: var(--dusk); }
.status-bar { padding: 10px 14px; border-radius: 8px; margin-bottom: 16px; font-size: 12px; }
.status-bar.info { background: var(--dusk-tint); color: var(--dusk); }
.status-bar.error { background: #fde0e4; color: var(--red); }
.summary-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(160px, 1fr)); gap: 10px; margin-bottom: 20px; }
.summary-card { background: var(--white); border: 1px solid var(--line); border-radius: 8px; padding: 12px 14px; }
.summary-card dt { font-size: 9px; text-transform: uppercase; color: var(--text-3); margin-bottom: 4px; }
.summary-card dd { margin: 0; font-weight: 700; font-size: 15px; }
/* .form-grid: use shared.css (3-column responsive layout) */
.ingest-submission-zone .form-field { display: flex; flex-direction: column; gap: 4px; }
.ingest-submission-zone .form-field label { font-size: 10px; font-weight: 700; color: var(--text-3); text-transform: uppercase; letter-spacing: 0.05em; }
.ingest-submission-zone .shell-page-header { display: block; }
.ingest-submission-zone .form-field input,
.ingest-submission-zone .form-field select {
  width: 100%;
  padding: 8px 10px;
  border-radius: 6px;
  border: 1px solid var(--line-strong);
  font-family: var(--font);
  font-size: 11.5px;
  background: var(--white);
  color: var(--text);
}
.ingest-submission-zone .form-field input:focus,
.ingest-submission-zone .form-field select:focus {
  outline: 2px solid var(--dusk);
  outline-offset: 1px;
  border-color: transparent;
}
.ingest-submission-zone .chart-card-head h3 .shell-count-badge { vertical-align: middle; }
.ingest-submission-zone .data-table .num { text-align: right; font-variant-numeric: tabular-nums; }
.empty { color: var(--text-3); padding: 24px; text-align: center; }
.dash-hybrid-banner { font-size: 12px; color: var(--text-3); background: var(--white-smoke); border: 1px solid var(--line); border-radius: 8px; padding: 10px 12px; margin-bottom: 14px; line-height: 1.45; }
.src-pill { font-size: 10px; font-weight: 600; padding: 2px 6px; border-radius: 3px; margin: 0 2px; }
.src-pill.src-dv { background: #e1f0e9; color: #1a6b45; }
.src-pill.src-html { background: #fff4e5; color: #8a5a00; }
.dash-mount-host .dash-inner { min-height: 120px; }
.section-view { display: none !important; }
.section-view.active { display: block !important; }
/* Data Ingestion: layout matches New update data_ingestion.html (picker → toolbar → #ingest-editor-area) */
#ingest-editor-area { margin-top: 0; }
.ingest-modal-actions .btn-cancel {
  background: transparent;
  color: var(--text-3);
  border: none;
  padding: 8px 14px;
  font-family: var(--font);
  font-weight: 500;
  font-size: 11.5px;
  cursor: pointer;
}
.ingest-modal-actions .btn-cancel:hover { color: var(--text); }
/* Section picker + .ingest-sec-btn: cf_clcpa_dash_shared_css (Data Ingestion tab) */
.ingestion-panel { display: none; }
.ingestion-panel.ingestion-panel--active { display: block; }
@media print {
  .sidebar { display: none !important; }
  .topbar-actions { display: none !important; }
  .app { grid-template-columns: 1fr; grid-template-rows: auto 1fr; grid-template-areas: "topbar" "content"; }
  .content { padding: 12px 16px 24px; overflow: visible; }
  .topbar { border-bottom: 1px solid var(--line); position: static; }
  .status-bar.info { background: transparent; border: 1px solid var(--line); }
}
</style>
</head>
<body>
<div class="app">
