      }).then(function (ids) {
        return ids.reduce(function (q, id) {
          return q.then(function () { return deleteRecordById(def.set, id); });
        }, Promise.resolve());
      });
    }, Promise.resolve());
  }

  function fetchPeriodRowsForCalendarYear(y) {
    var yi = parseInt(y, 10);
    var filt = 'cf_calendaryear eq ' + yi + ' and statecode eq 0';
    var sel = 'cf_dimperiodid,cf_calendaryear,cf_periodlabel,cf_periodgrain,cf_isreportperiod,cf_periodstartdate,cf_periodenddate,cf_calendarmonth,cf_calendarquarter';
    var path = API + 'cf_dimperiods?$select=' + encodeURIComponent(sel) + '&$filter=' + encodeURIComponent(filt);
    function pull(url) {
      return (url.indexOf('http') === 0 ? odataFetchUrl(url) : dvFetch(url)).then(function (r) {
        if (!r.ok) throw new Error('Period template read failed (' + r.status + ')');
        return r.json();
      }).then(function (d) {
        var part = d.value || [];
        if (d['@odata.nextLink']) {
          return pull(d['@odata.nextLink']).then(function (rest) { return part.concat(rest); });
        }
        return part;
      });
    }
    return pull(path);
  }

  function shiftODataDate(val, deltaYears) {
    if (val == null || val === '') return null;
    var d = new Date(val);
    if (isNaN(d.getTime())) return null;
    d.setUTCFullYear(d.getUTCFullYear() + deltaYears);
    return d.toISOString();
  }

  function buildClonedPeriodPayload(src, templateYear, newYear) {
    var dy = parseInt(newYear, 10) - parseInt(templateYear, 10);
    var lab = src.cf_periodlabel ? String(src.cf_periodlabel) : '';
    var ts = String(templateYear);
    var ns = String(newYear);
    var newLab = lab.replace(new RegExp('\\b' + ts + '\\b', 'g'), ns);
    if (newLab === lab && lab.indexOf(ts) >= 0) newLab = lab.split(ts).join(ns);
    var body = {
      cf_calendaryear: parseInt(newYear, 10),
      cf_periodgrain: src.cf_periodgrain,
      cf_periodlabel: newLab || ns,
      cf_isreportperiod: src.cf_isreportperiod === true
    };
    if (src.cf_calendarmonth != null) body.cf_calendarmonth = src.cf_calendarmonth;
    if (src.cf_calendarquarter != null) body.cf_calendarquarter = src.cf_calendarquarter;
    var s = shiftODataDate(src.cf_periodstartdate, dy);
    var e = shiftODataDate(src.cf_periodenddate, dy);
    if (s) body.cf_periodstartdate = s;
    if (e) body.cf_periodenddate = e;
    return body;
  }

  function createReportingYearFromTemplate(newYearStr) {
    var newY = parseInt(newYearStr, 10);
    if (isNaN(newY) || newY < 2000 || newY > 2099) {
      return Promise.reject(new Error('Enter a valid 4-digit year.'));
    }
    var hasYear = periods.some(function (p) { return parseInt(p.cf_calendaryear, 10) === newY; });
    if (hasYear) {
      return Promise.reject(new Error('That calendar year already exists in DIM PERIOD.'));
    }
    var ys = distinctCalendarYearsFromPeriods();
    var templateYear = ys.length ? Math.max.apply(null, ys) : null;
    if (!templateYear) {
      return Promise.reject(new Error('No existing periods to use as a template.'));
    }
    return fetchPeriodRowsForCalendarYear(templateYear).then(function (rows) {
      if (!rows.length) {
        return Promise.reject(new Error('Template year ' + templateYear + ' has no period rows.'));
      }
      return rows.reduce(function (pms, src) {
        return pms.then(function () {
          var body = buildClonedPeriodPayload(src, templateYear, newY);
          return dvFetch(API + 'cf_dimperiods', { method: 'POST', body: JSON.stringify(body) }).then(function (r) {
            if (!r.ok) {
              return parseJsonSafe(r).then(function (j) {
                throw new Error((j.error && j.error.message) || ('Create period failed ' + r.status));
              });
            }
          });
        });
      }, Promise.resolve());
    }).then(function () {
      return loadPeriods();
    }).then(function () {
      fillYearSelects();
      applyGlobalReportingYear(String(newY));
      showStatus('Created DIM PERIOD rows for ' + newY + ' (cloned from ' + templateYear + '). No fact rows were copied.', false);
    });
  }

  function deleteReportingYearCascade(yearStr) {
    var y = parseInt(yearStr, 10);
    var periodIds = periods.filter(function (p) { return parseInt(p.cf_calendaryear, 10) === y; }).map(function (p) { return p.cf_dimperiodid; });
    var distinctYears = distinctCalendarYearsFromPeriods();
    if (distinctYears.length <= 1) {
      return Promise.reject(new Error('Cannot delete the only calendar year in DIM PERIOD.'));
    }
    if (!periodIds.length) {
      return Promise.reject(new Error('No periods found for year ' + yearStr + '.'));
    }
    var filt = periodIds.map(function (id) { return '_cf_period_value eq ' + id; }).join(' or ');
    return deleteFactsForPeriodFilter(filt).then(function () {
      return periodIds.reduce(function (pms, pid) {
        return pms.then(function () { return deleteRecordById('cf_dimperiods', pid); });
      }, Promise.resolve());
    }).then(function () {
      return loadPeriods();
    }).then(function () {
      fillYearSelects();
      var remain = distinctCalendarYearsFromPeriods().sort(function (a, b) { return b - a; });
      if (remain.length) applyGlobalReportingYear(String(remain[0]));
      showStatus('Deleted reporting year ' + yearStr + ' (all Section A–J facts for those periods, then DIM PERIOD rows).', false);
    });
  }

