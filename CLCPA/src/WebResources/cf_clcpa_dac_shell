  function gatherPrimaryKeys(entitySet, idField, filterExpr) {
    var acc = [];
    var path = API + entitySet + '?$select=' + encodeURIComponent(idField) + '&$filter=' + encodeURIComponent(filterExpr);
    function pull(url) {
      return (url.indexOf('http') === 0 ? odataFetchUrl(url) : dvFetch(url)).then(function (r) {
        if (!r.ok) throw new Error(entitySet + ' $filter query failed (' + r.status + ')');
        return r.json();
      }).then(function (d) {
        (d.value || []).forEach(function (row) {
          if (row[idField]) acc.push(row[idField]);
        });
        if (d['@odata.nextLink']) return pull(d['@odata.nextLink']);
        return acc;
      });
    }
    return pull(path);
  }

  function deleteRecordById(entitySet, id) {
    return dvFetch(API + entitySet + '(' + id + ')', { method: 'DELETE' }).then(function (r) {
      if (r.status === 204 || r.status === 404) return;
      return r.text().then(function (t) {
        throw new Error('DELETE ' + entitySet + ' ' + r.status + ' ' + t);
