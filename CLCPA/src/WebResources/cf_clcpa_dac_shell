    var vEap = intOrNullRounded('sect-j-eap');
    var vA = numOrNull('sect-j-arrears');
    var editMode = !!(idR || idE || idA);

    var rows = [
      { code: METRIC_J_RESIDENTIAL, dollars: false, acctVal: vR, dollarVal: null, id: idR },
      { code: METRIC_J_EAP, dollars: false, acctVal: vEap, dollarVal: null, id: idE },
      { code: METRIC_J_ARREARS, dollars: true, acctVal: null, dollarVal: vA, id: idA }
    ];

    document.getElementById('sect-j-btn-save').disabled = true;

    function writeOne(row) {
      var body = buildRowPayloadJ(periodId, geoGuid, useGeo, acctNorm, usageNorm, row.code, row.dollars, row.acctVal, row.dollarVal);
      function patchOrPost(resolvedId) {
        var url, method, headers = {};
        if (resolvedId) {
          method = 'PATCH';
          url = API + ENTITY_SET_J + '(' + resolvedId + ')';
          headers['If-Match'] = '*';
        } else {
          method = 'POST';
          url = API + ENTITY_SET_J;
        }
        return dvFetch(url, { method: method, body: JSON.stringify(body), headers: headers }).then(function (r) {
          if (!r.ok) {
            return parseJsonSafe(r).then(function (j) {
              throw new Error((j.error && j.error.message) || ('Save ' + row.code + ' failed ' + r.status));
            });
          }
        });
      }
      if (editMode && row.id) {
        return patchOrPost(row.id);
      }
      return findExistingJMetricId(periodId, geoGuid, useGeo, acctNorm, usageNorm, row.code).then(function (existing) {
        return patchOrPost(existing);
      });
    }

    var chain = rows.reduce(function (p, row) {
      return p.then(function () { return writeOne(row); });
    }, Promise.resolve());

    chain.then(function () {
      showStatus('Section J: saved.', false);
      clearFormJ();
      return loadFactsJ().then(function () {
        refreshDashboardForActiveSectionAfterSave('j');
      });
    }).catch(function (e) {
      showStatus(e.message, true);
    }).then(function () {
      document.getElementById('sect-j-btn-save').disabled = false;
    });
  }

